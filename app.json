{
  "expo": {
    "name": "RateMyBar",
    "slug": "RateMyBar",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "?"
      },
      "bundleIdentifier": "com.peterkingdev.ratemybar",
      "buildNumber": "1.0.6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RateMyBar needs your location to determine which bars are near you. Your location is not stored outside the app.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RateMyBar needs your location to determine which bars are near you. Your location is not stored outside the app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "serverIP": "http://3.143.49.243:3050/"
    }
  }
}
